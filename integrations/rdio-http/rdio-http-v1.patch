+func TestSweepHTTPConfiguredDelayProtectsMissingMarkerAndCurrentDelayChanges(t *testing.T) {
+	h := sweepFixture(t)
+	db := h.controller.Database.Sql
+	for _, statement := range []string{
+		`UPDATE systems SET delay = 5 WHERE systemId = 1`,
+		fmt.Sprintf(`UPDATE calls SET timestamp = %d WHERE callId = 101`, time.Now().Add(-2*time.Minute).UnixMilli()),
+	} {
+		if _, err := db.Exec(statement); err != nil {
+			t.Fatal(err)
+		}
+	}
+	assertAvailable := func(available bool) {
+		t.Helper()
+		list := sweepRequest(h, "calls", `{"pin":"PRIVATE-PIN"}`)
+		var result struct {
+			Count int         `json:"count"`
+			Calls []sweepCall `json:"calls"`
+		}
+		if list.Code != 200 || json.Unmarshal(list.Body.Bytes(), &result) != nil {
+			t.Fatalf("list failed: %d %s", list.Code, list.Body)
+		}
+		wantCount, wantStatus := 0, 404
+		if available {
+			wantCount, wantStatus = 1, 200
+		}
+		if result.Count != wantCount || len(result.Calls) != wantCount {
+			t.Fatalf("configured-delay list: %#v; available=%v", result, available)
+		}
+		if audio := sweepRequest(h, "audio", `{"pin":"PRIVATE-PIN","callId":101}`); audio.Code != wantStatus {
+			t.Fatalf("configured-delay audio: %d; want=%d", audio.Code, wantStatus)
+		}
+	}
+	// No delayed row exists for call 101: protect both the ingest-before-marker
+	// interval and a failed marker insertion using the current configured delay.
+	assertAvailable(false)
+	if _, err := db.Exec(`UPDATE talkgroups SET delay = 1 WHERE talkgroupId = 11`); err != nil {
+		t.Fatal(err)
+	}
+	assertAvailable(true) // Positive talkgroup delay overrides the system delay.
+	if _, err := db.Exec(`UPDATE talkgroups SET delay = 3 WHERE talkgroupId = 11`); err != nil {
+		t.Fatal(err)
+	}
+	assertAvailable(false) // An increased delay also hides an older unmarked call.
+	if _, err := db.Exec(`UPDATE talkgroups SET delay = 2147483647 WHERE talkgroupId = 11`); err != nil {
+		t.Fatal(err)
+	}
+	assertAvailable(false) // Millisecond arithmetic must not overflow an int column.
+}
