+func TestSweepHTTPSlowBodyReadHasConnectionDeadline(t *testing.T) {
+	h := sweepFixture(t)
+	t.Setenv("SWEEP_RDIO_HTTP", "1")
+	mux := http.NewServeMux()
+	RegisterSweepHTTP(h.controller, mux)
+	server := httptest.NewServer(mux)
+	defer server.Close()
+	connections := []net.Conn{}
+	for i := 0; i < 8; i++ {
+		conn, err := net.DialTimeout("tcp", server.Listener.Addr().String(), time.Second)
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer conn.Close()
+		connections = append(connections, conn)
+		if err := conn.SetDeadline(time.Now().Add(8 * time.Second)); err != nil {
+			t.Fatal(err)
+		}
+		// Occupy every slot with a body that never arrives. A context timeout
+		// alone does not unblock these socket reads or release the slots.
+		if _, err := fmt.Fprint(conn, "POST /sweep-rdio/v1/config HTTP/1.1\r\nHost: localhost\r\nContent-Type: application/json\r\nContent-Length: 100\r\nConnection: close\r\n\r\n"); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for _, conn := range connections {
+		response, err := http.ReadResponse(bufio.NewReader(conn), nil)
+		if err != nil {
+			t.Fatalf("body read did not return before the client deadline: %v", err)
+		}
+		response.Body.Close()
+		// Read timeout can cancel the request before the parser's 400 wins.
+		if response.StatusCode != 400 && response.StatusCode != 503 {
+			t.Fatalf("slow body status %d", response.StatusCode)
+		}
+	}
+	client := &http.Client{Timeout: 2 * time.Second}
+	response, err := client.Post(server.URL+"/sweep-rdio/v1/config", "application/json", strings.NewReader(`{"pin":"PRIVATE-PIN"}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer response.Body.Close()
+	if response.StatusCode != 200 {
+		t.Fatalf("stalled bodies retained all operation slots: %d", response.StatusCode)
+	}
+}
