+func sweepFixture(t *testing.T) *sweepHTTP {
+	t.Helper()
+	db, err := sql.Open("sqlite", ":memory:")
+	if err != nil {
+		t.Fatal(err)
+	}
+	db.SetMaxOpenConns(1)
+	t.Cleanup(func() { db.Close() })
+	for _, query := range []string{
+		`CREATE TABLE systems (systemId INTEGER, systemRef INTEGER, delay INTEGER NOT NULL DEFAULT 0)`,
+		`CREATE TABLE talkgroups (talkgroupId INTEGER, systemId INTEGER, talkgroupRef INTEGER, delay INTEGER NOT NULL DEFAULT 0)`,
+		`CREATE TABLE calls (callId INTEGER, systemId INTEGER, talkgroupId INTEGER, timestamp INTEGER, audio BLOB, audioMime TEXT)`,
+		`CREATE TABLE delayed (callId INTEGER, timestamp INTEGER)`,
+		`INSERT INTO systems (systemId, systemRef) VALUES (1,1),(2,2)`,
+		`INSERT INTO talkgroups (talkgroupId, systemId, talkgroupRef) VALUES (11,1,11),(12,1,12),(21,2,21)`,
+		`INSERT INTO delayed VALUES (104,9999999999999)`,
+	} {
+		if _, err := db.Exec(query); err != nil {
+			t.Fatal(err)
+		}
+	}
+	audio := make([]byte, 44)
+	copy(audio, "RIFF")
+	copy(audio[8:], "WAVE")
+	for _, call := range []struct{ id, system, group int }{{101, 1, 11}, {102, 1, 12}, {103, 2, 21}, {104, 1, 11}} {
+		if _, err := db.Exec(`INSERT INTO calls VALUES (?,?,?,?,?,?)`, call.id, call.system, call.group, time.Now().Add(-time.Hour).UnixMilli()+int64(call.id), audio, "audio/wav"); err != nil {
+			t.Fatal(err)
+		}
+	}
+	controller := &Controller{Accesses: NewAccesses(), Systems: NewSystems(), Database: &Database{Config: &Config{DbType: DbTypeSqlite}, Sql: db}}
+	for _, ref := range []uint{1, 2} {
+		system := NewSystem()
+		system.SystemRef = ref
+		system.Label = "System"
+		groups := []uint{11, 12}
+		if ref == 2 {
+			groups = []uint{21}
+		}
+		for _, id := range groups {
+			group := NewTalkgroup()
+			group.TalkgroupRef = id
+			group.Label = "Dispatch"
+			system.Talkgroups.List = append(system.Talkgroups.List, group)
+		}
+		controller.Systems.List = append(controller.Systems.List, system)
+	}
+	controller.Accesses.List = []*Access{{Code: "PRIVATE-PIN", Systems: []any{map[string]any{"id": float64(1), "talkgroups": []any{float64(11)}}}}}
+	return &sweepHTTP{controller: controller, failures: map[string]sweepPeerFailures{}, busy: make(chan struct{}, 8)}
+}
+
+func sweepRequest(h *sweepHTTP, route, body string) *httptest.ResponseRecorder {
+	r := httptest.NewRequest(http.MethodPost, "https://example.test/sweep-rdio/v1/"+route, strings.NewReader(body))
+	r.RemoteAddr = "192.0.2.4:49152"
+	r.TLS = &tls.ConnectionState{}
+	r.Header.Set("Content-Type", "application/json")
+	w := httptest.NewRecorder()
+	h.serve(w, r, route)
+	return w
+}
+
+func TestSweepHTTPConfigContainsOnlyAuthorizedScopeAndNoCredentials(t *testing.T) {
+	h := sweepFixture(t)
+	w := sweepRequest(h, "config", `{"pin":"PRIVATE-PIN"}`)
+	if w.Code != 200 {
+		t.Fatalf("status %d: %s", w.Code, w.Body)
+	}
+	var config struct {
+		Systems []sweepSystem `json:"systems"`
+	}
+	if err := json.Unmarshal(w.Body.Bytes(), &config); err != nil {
+		t.Fatal(err)
+	}
+	if len(config.Systems) != 1 || config.Systems[0].ID != 1 || len(config.Systems[0].Talkgroups) != 1 || config.Systems[0].Talkgroups[0].ID != 11 {
+		t.Fatalf("unscoped metadata: %#v", config)
+	}
+	if strings.Contains(w.Body.String(), "PRIVATE-PIN") {
+		t.Fatal("PIN in response")
+	}
+	if w.Header().Get("Cache-Control") != "no-store" {
+		t.Fatal("missing no-store")
+	}
+}
+
+func TestSweepHTTPCallsAndAudioExcludeUnauthorizedAndDelayedCalls(t *testing.T) {
+	h := sweepFixture(t)
+	w := sweepRequest(h, "calls", `{"pin":"PRIVATE-PIN","limit":50,"offset":0}`)
+	if w.Code != 200 {
+		t.Fatalf("list status %d: %s", w.Code, w.Body)
+	}
+	var result struct {
+		Count int         `json:"count"`
+		Calls []sweepCall `json:"calls"`
+	}
+	json.Unmarshal(w.Body.Bytes(), &result)
+	if result.Count != 1 || len(result.Calls) != 1 || result.Calls[0].ID != 101 {
+		t.Fatalf("unscoped/delayed calls: %#v", result)
+	}
+	if w = sweepRequest(h, "audio", `{"pin":"PRIVATE-PIN","callId":101}`); w.Code != 200 || !bytes.HasPrefix(w.Body.Bytes(), []byte("RIFF")) {
+		t.Fatalf("audio status %d", w.Code)
+	}
+	for _, id := range []string{"102", "103", "104"} {
+		w = sweepRequest(h, "audio", `{"pin":"PRIVATE-PIN","callId":`+id+`}`)
+		if w.Code != 404 {
+			t.Fatalf("unauthorized/delayed call %s returned %d", id, w.Code)
+		}
+	}
+}
