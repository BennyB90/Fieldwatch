+func TestSweepHTTPConcurrentWrongPinsCannotOvershootFailureBudget(t *testing.T) {
+	h := sweepFixture(t)
+	start := make(chan struct{})
+	statuses := make(chan int, 32)
+	var pending sync.WaitGroup
+	for i := 0; i < 32; i++ {
+		pending.Add(1)
+		go func() {
+			defer pending.Done()
+			<-start
+			_, status := h.authorizePeer("192.0.2.4", "WRONG")
+			statuses <- status
+		}()
+	}
+	close(start)
+	pending.Wait()
+	close(statuses)
+	failures, throttled := 0, 0
+	for status := range statuses {
+		switch status {
+		case 401:
+			failures++
+		case 429:
+			throttled++
+		default:
+			t.Fatalf("unexpected status %d", status)
+		}
+	}
+	if failures != 5 || throttled != 27 {
+		t.Fatalf("parallel budget overshot: failures=%d throttled=%d", failures, throttled)
+	}
+	if _, status := h.authorizePeer("192.0.2.4", "PRIVATE-PIN"); status != 429 {
+		t.Fatalf("valid code bypassed failed-attempt budget: %d", status)
+	}
+}
