@@ -0,0 +1,435 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright 2026 SWEEP contributors.
+// Original opt-in HTTP companion, compiled with Rdio Scanner's GPL server.
+// No WebSocket code, admin credentials, stream relay, or automatic polling.
+package main
+
+import (
+	"crypto/subtle"
+	"database/sql"
+	"encoding/json"
+	"fmt"
+	"io"
+	"mime"
+	"net"
+	"net/http"
+	"os"
+	"strings"
+	"sync"
+	"time"
+	"unicode"
+)
+
+const sweepMaxAudio = 8 * 1024 * 1024
+const sweepMaxJSON = 1024 * 1024
+
+type sweepHTTPRequest struct {
+	Pin    string `json:"pin"`
+	Limit  int    `json:"limit,omitempty"`
+	Offset int    `json:"offset,omitempty"`
+	CallID int64  `json:"callId,omitempty"`
+}
+type sweepTalkgroup struct {
+	ID    uint   `json:"id"`
+	Label string `json:"label"`
+	Name  string `json:"name"`
+}
+type sweepSystem struct {
+	ID         uint             `json:"id"`
+	Label      string           `json:"label"`
+	Talkgroups []sweepTalkgroup `json:"talkgroups"`
+}
+type sweepCall struct {
+	ID        int64  `json:"id"`
+	System    uint   `json:"system"`
+	Talkgroup uint   `json:"talkgroup"`
+	DateTime  string `json:"dateTime"`
+}
+type sweepPeerFailures struct {
+	Count int
+	Until time.Time
+}
+type sweepHTTP struct {
+	controller *Controller
+	mutex      sync.Mutex
+	failures   map[string]sweepPeerFailures
+	busy       chan struct{}
+}
+
+// Only the operator can enable this companion; normal upstream behavior is unchanged.
+func RegisterSweepHTTP(controller *Controller, mux *http.ServeMux) {
+	if os.Getenv("SWEEP_RDIO_HTTP") != "1" {
+		return
+	}
+	h := &sweepHTTP{controller: controller, failures: map[string]sweepPeerFailures{}, busy: make(chan struct{}, 8)}
+	for _, route := range []string{"config", "calls", "audio"} {
+		route := route
+		bounded := http.TimeoutHandler(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { h.serve(w, r, route) }), 20*time.Second, `{"apiVersion":1,"error":"request_timeout"}`)
+		mux.Handle("/sweep-rdio/v1/"+route, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("Cache-Control", "no-store")
+			w.Header().Set("Pragma", "no-cache")
+			w.Header().Set("X-Content-Type-Options", "nosniff")
+			w.Header().Set("Content-Type", "application/json")
+			// A context timeout alone does not unblock a stalled request-body read.
+			// Set this on the real connection before TimeoutHandler wraps the writer.
+			connection := http.NewResponseController(w)
+			if connection.SetReadDeadline(time.Now().Add(5*time.Second)) != nil {
+				sweepHTTPError(w, 503, "body_deadline_unavailable")
+				return
+			}
+			defer connection.SetReadDeadline(time.Time{})
+			bounded.ServeHTTP(w, r)
+		}))
+	}
+}
+
+func (h *sweepHTTP) serve(w http.ResponseWriter, r *http.Request, route string) {
+	w.Header().Set("Cache-Control", "no-store")
+	w.Header().Set("Pragma", "no-cache")
+	w.Header().Set("X-Content-Type-Options", "nosniff")
+	if r.Method != http.MethodPost {
+		sweepHTTPError(w, 405, "post_required")
+		return
+	}
+	// TLS termination on a local reverse proxy is supported. Never trust caller-supplied X-Forwarded-Proto.
+	peer, _, err := net.SplitHostPort(r.RemoteAddr)
+	if err != nil {
+		sweepHTTPError(w, 400, "invalid_request")
+		return
+	}
+	ip := net.ParseIP(peer)
+	if r.TLS == nil && (ip == nil || !ip.IsLoopback()) {
+		sweepHTTPError(w, 403, "https_required")
+		return
+	}
+	if r.URL.RawQuery != "" {
+		sweepHTTPError(w, 400, "body_required")
+		return
+	}
+	mediaType, _, err := mime.ParseMediaType(r.Header.Get("Content-Type"))
+	if err != nil || mediaType != "application/json" {
+		sweepHTTPError(w, 415, "json_required")
+		return
+	}
+	select {
+	case h.busy <- struct{}{}:
+		defer func() { <-h.busy }()
+	default:
+		sweepHTTPError(w, 503, "busy")
+		return
+	}
+	r.Body = http.MaxBytesReader(w, r.Body, 8192)
+	defer r.Body.Close()
+	var request sweepHTTPRequest
+	decoder := json.NewDecoder(r.Body)
+	decoder.DisallowUnknownFields()
+	if decoder.Decode(&request) != nil || decoder.Decode(new(any)) != io.EOF || len([]rune(request.Pin)) > 128 || strings.IndexFunc(request.Pin, func(ch rune) bool { return unicode.IsControl(ch) || unicode.Is(unicode.Cf, ch) }) >= 0 {
+		sweepHTTPError(w, 400, "invalid_request")
+		return
+	}
+	access, status := h.authorizePeer(peer, request.Pin)
+	request.Pin = "" // Never put a PIN in a URL, error, response, or application log.
+	if status != 0 {
+		code := "invalid_or_expired_access"
+		if status == 403 {
+			code = "unsupported_connection_limit_or_scope"
+		} else if status == 429 {
+			code = "access_rate_limited"
+		}
+		sweepHTTPError(w, status, code)
+		return
+	}
+	// Successful requests do not erase failed attempts, so mixed valid/invalid codes cannot bypass throttling.
+	systems, ok := h.scopedSystems(access)
+	if !ok {
+		sweepHTTPError(w, 413, "configuration_too_large")
+		return
+	}
+	switch route {
+	case "config":
+		sweepHTTPJSON(w, map[string]any{"apiVersion": 1, "systems": systems})
+	case "calls":
+		if request.Limit == 0 {
+			request.Limit = 50
+		}
+		if request.Limit < 1 || request.Limit > 100 || request.Offset < 0 || request.Offset > 1000000 {
+			sweepHTTPError(w, 400, "invalid_page")
+			return
+		}
+		h.calls(w, r, systems, request)
+	case "audio":
+		if request.CallID <= 0 {
+			sweepHTTPError(w, 400, "invalid_call")
+			return
+		}
+		h.audio(w, r, systems, request.CallID)
+	default:
+		sweepHTTPError(w, 404, "not_found")
+	}
+}
+
+// Snapshot listener scope under the same access-list lock used by the upstream settings.
+func (h *sweepHTTP) authorize(pin string) (*Access, int) {
+	a := h.controller.Accesses
+	a.mutex.Lock()
+	defer a.mutex.Unlock()
+	if len(a.List) == 0 {
+		return &Access{Systems: "*"}, 0
+	}
+	for _, candidate := range a.List {
+		if subtle.ConstantTimeCompare([]byte(candidate.Code), []byte(pin)) != 1 {
+			continue
+		}
+		if candidate.HasExpired() {
+			return nil, 401
+		}
+		// Stateless POSTs have no listener lease. Reject these codes instead of bypassing their limit.
+		if candidate.Limit > 0 || candidate.Systems == nil {
+			return nil, 403
+		}
+		bytes, err := json.Marshal(candidate.Systems)
+		if err != nil {
+			return nil, 403
+		}
+		copy := &Access{}
+		if json.Unmarshal(bytes, &copy.Systems) != nil {
+			return nil, 403
+		}
+		return copy, 0
+	}
+	return nil, 401
+}
+
+func (h *sweepHTTP) scopedSystems(access *Access) ([]sweepSystem, bool) {
+	result := []sweepSystem{}
+	total := 0
+	systems := h.controller.Systems
+	systems.mutex.Lock()
+	defer systems.mutex.Unlock()
+	for _, system := range systems.List {
+		row := sweepSystem{ID: system.SystemRef, Label: sweepText(system.Label), Talkgroups: []sweepTalkgroup{}}
+		system.Talkgroups.mutex.Lock()
+		for _, talkgroup := range system.Talkgroups.List {
+			if access.HasAccess(&Call{System: system, Talkgroup: talkgroup}) {
+				if len(row.Talkgroups) >= 1000 || total+len(row.Talkgroups) >= 5000 {
+					system.Talkgroups.mutex.Unlock()
+					return nil, false
+				}
+				row.Talkgroups = append(row.Talkgroups, sweepTalkgroup{talkgroup.TalkgroupRef, sweepText(talkgroup.Label), sweepText(talkgroup.Name)})
+			}
+		}
+		system.Talkgroups.mutex.Unlock()
+		if len(row.Talkgroups) == 0 {
+			continue
+		}
+		total += len(row.Talkgroups)
+		if len(row.Talkgroups) > 1000 || total > 5000 || len(result) >= 200 {
+			return nil, false
+		}
+		result = append(result, row)
+	}
+	return result, true
+}
+
+func sweepScope(systems []sweepSystem) (string, []any) {
+	parts := []string{}
+	args := []any{}
+	for _, system := range systems {
+		marks := []string{}
+		args = append(args, system.ID)
+		for _, group := range system.Talkgroups {
+			marks = append(marks, "?")
+			args = append(args, group.ID)
+		}
+		if len(marks) > 0 {
+			parts = append(parts, `(s."systemRef" = ? AND t."talkgroupRef" IN (`+strings.Join(marks, ",")+`))`)
+		}
+	}
+	if len(parts) == 0 {
+		return "0 = 1", nil
+	}
+	return "(" + strings.Join(parts, " OR ") + ")", args
+}
+
+// An ingest writes the call before creating its delayed marker. Enforce the
+// current database delay as well as the marker so that interval (or a failed
+// marker write) cannot expose a call early. A positive talkgroup delay overrides
+// its system delay; upstream delay units are minutes. Decimal arithmetic avoids
+// overflowing PostgreSQL's integer delay column during millisecond conversion.
+const sweepEffectiveDelay = `CASE WHEN t."delay" > 0 THEN t."delay" ELSE s."delay" END`
+const sweepJoinedCalls = ` FROM "calls" c JOIN "systems" s ON s."systemId" = c."systemId" JOIN "talkgroups" t ON t."talkgroupId" = c."talkgroupId" LEFT JOIN "delayed" d ON d."callId" = c."callId" WHERE d."callId" IS NULL AND ((` + sweepEffectiveDelay + `) = 0 OR c."timestamp" <= ? - CAST((` + sweepEffectiveDelay + `) AS DECIMAL(20,0)) * 60000) AND `
+
+func (h *sweepHTTP) querySQL(query string) string {
+	if h.controller.Database.Config.DbType != DbTypePostgresql {
+		return query
+	}
+	index := 0
+	var out strings.Builder
+	for _, ch := range query {
+		if ch == '?' {
+			index++
+			fmt.Fprintf(&out, "$%d", index)
+		} else {
+			out.WriteRune(ch)
+		}
+	}
+	return out.String()
+}
+
+func (h *sweepHTTP) calls(w http.ResponseWriter, r *http.Request, systems []sweepSystem, request sweepHTTPRequest) {
+	where, args := sweepScope(systems)
+	args = append([]any{time.Now().UnixMilli()}, args...)
+	// PostgreSQL defaults to READ COMMITTED, which could count a different
+	// archive than the following page query. Both statements share one snapshot.
+	tx, err := h.controller.Database.Sql.BeginTx(r.Context(), &sql.TxOptions{Isolation: sql.LevelRepeatableRead, ReadOnly: true})
+	if err != nil {
+		sweepHTTPError(w, 500, "server_error")
+		return
+	}
+	defer tx.Rollback()
+	var count int64
+	if err = tx.QueryRowContext(r.Context(), h.querySQL(`SELECT COUNT(*)`+sweepJoinedCalls+where), args...).Scan(&count); err != nil {
+		sweepHTTPError(w, 500, "server_error")
+		return
+	}
+	pageArgs := append(append([]any{}, args...), request.Limit, request.Offset)
+	rows, err := tx.QueryContext(r.Context(), h.querySQL(`SELECT c."callId", c."timestamp", s."systemRef", t."talkgroupRef"`+sweepJoinedCalls+where+` ORDER BY c."timestamp" DESC, c."callId" DESC LIMIT ? OFFSET ?`), pageArgs...)
+	if err != nil {
+		sweepHTTPError(w, 500, "server_error")
+		return
+	}
+	result := []sweepCall{}
+	for rows.Next() {
+		var call sweepCall
+		var timestamp int64
+		if rows.Scan(&call.ID, &timestamp, &call.System, &call.Talkgroup) != nil {
+			rows.Close()
+			sweepHTTPError(w, 500, "server_error")
+			return
+		}
+		call.DateTime = time.UnixMilli(timestamp).UTC().Format(time.RFC3339Nano)
+		result = append(result, call)
+	}
+	err = rows.Err()
+	rows.Close()
+	if err != nil || tx.Commit() != nil {
+		sweepHTTPError(w, 500, "server_error")
+		return
+	}
+	var next any = nil
+	if len(result) > 0 && int64(request.Offset+len(result)) < count && request.Offset+len(result) <= 1000000 {
+		next = request.Offset + len(result)
+	}
+	sweepHTTPJSON(w, map[string]any{"apiVersion": 1, "count": count, "limit": request.Limit, "offset": request.Offset, "nextOffset": next, "calls": result})
+}
+
+func (h *sweepHTTP) audio(w http.ResponseWriter, r *http.Request, systems []sweepSystem, id int64) {
+	where, args := sweepScope(systems)
+	args = append([]any{time.Now().UnixMilli()}, args...)
+	args = append(args, id)
+	var size int64
+	query := `SELECT LENGTH(c."audio")` + sweepJoinedCalls + where + ` AND c."callId" = ?`
+	err := h.controller.Database.Sql.QueryRowContext(r.Context(), h.querySQL(query), args...).Scan(&size)
+	if err == sql.ErrNoRows {
+		sweepHTTPError(w, 404, "call_unavailable")
+		return
+	}
+	if err != nil {
+		sweepHTTPError(w, 500, "server_error")
+		return
+	}
+	if size < 1 || size > sweepMaxAudio {
+		sweepHTTPError(w, 413, "audio_too_large")
+		return
+	}
+	var audio []byte
+	var rawType string
+	query = `SELECT c."audio", c."audioMime"` + sweepJoinedCalls + where + ` AND c."callId" = ? AND LENGTH(c."audio") <= ?`
+	err = h.controller.Database.Sql.QueryRowContext(r.Context(), h.querySQL(query), append(args, sweepMaxAudio)...).Scan(&audio, &rawType)
+	if err == sql.ErrNoRows {
+		sweepHTTPError(w, 404, "call_unavailable")
+		return
+	}
+	if err != nil {
+		sweepHTTPError(w, 500, "server_error")
+		return
+	}
+	kind, _, err := mime.ParseMediaType(rawType)
+	if err != nil || !sweepAudioType(kind) {
+		sweepHTTPError(w, 415, "unsupported_audio")
+		return
+	}
+	if len(audio) == 0 || len(audio) > sweepMaxAudio {
+		sweepHTTPError(w, 413, "audio_too_large")
+		return
+	}
+	w.Header().Set("Content-Type", kind)
+	w.Header().Set("Content-Length", fmt.Sprint(len(audio)))
+	w.WriteHeader(200)
+	w.Write(audio)
+}
+
+func sweepAudioType(kind string) bool {
+	switch kind {
+	case "audio/mpeg", "audio/mp3", "audio/aac", "audio/mp4", "audio/x-m4a", "audio/wav", "audio/x-wav", "audio/wave", "audio/ogg", "audio/flac", "audio/x-flac":
+		return true
+	}
+	return false
+}
+func sweepText(text string) string {
+	clean := []rune(strings.Map(func(ch rune) rune {
+		if unicode.IsControl(ch) || unicode.Is(unicode.Cf, ch) {
+			return -1
+		}
+		return ch
+	}, text))
+	if len(clean) > 120 {
+		clean = clean[:120]
+	}
+	return string(clean)
+}
+func sweepHTTPError(w http.ResponseWriter, status int, code string) {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(status)
+	json.NewEncoder(w).Encode(map[string]any{"apiVersion": 1, "error": code})
+}
+func sweepHTTPJSON(w http.ResponseWriter, value any) {
+	data, err := json.Marshal(value)
+	if err != nil {
+		sweepHTTPError(w, 500, "server_error")
+		return
+	}
+	if len(data) > sweepMaxJSON {
+		sweepHTTPError(w, 413, "response_too_large")
+		return
+	}
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(200)
+	w.Write(data)
+}
+
+// Serialize budget checks and authentication to prevent parallel requests from
+// overshooting the five-failure budget. No upstream path takes this local lock.
+func (h *sweepHTTP) authorizePeer(peer, pin string) (*Access, int) {
+	h.mutex.Lock()
+	defer h.mutex.Unlock()
+	now := time.Now()
+	for key, state := range h.failures {
+		if !now.Before(state.Until) {
+			delete(h.failures, key)
+		}
+	}
+	state, exists := h.failures[peer]
+	if (!exists && len(h.failures) >= 2048) || (exists && state.Count >= 5) {
+		return nil, 429
+	}
+	access, status := h.authorize(pin)
+	if status == 401 {
+		state.Count++
+		if state.Until.IsZero() {
+			state.Until = now.Add(15 * time.Minute)
+		}
+		h.failures[peer] = state
+	}
+	return access, status
+}
